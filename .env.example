# Copy to .env and put your own values in. Never commit .env.
#
#   SESSION_SECRET  signs staff session cookies. At least 24 characters.
#                   Rotating it signs everyone out.
#   ADMIN_PASSWORD  the first administrator's password, used once to create
#                   the account on an empty database. At least 8 characters.
#                   Changing it later does nothing; sign in and change it there.
#   COOKIE_SECURE   true once the site is behind HTTPS.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

SESSION_SECRET=replace-me-with-at-least-24-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
COOKIE_SECURE=false
SESSION_HOURS=12
